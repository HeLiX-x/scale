# Control plane
PORT=8080
JWT_SECRET=replace_with_random_32_byte_secret
DEVICE_AUTH_SECRET=replace_with_another_random_secret

# PostgreSQL — must be 127.0.0.1 / localhost
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=scale_user
DB_PASSWORD=replace_with_strong_password
DB_NAME=scale_db
DATABASE_URL=postgres://scale_user:replace_with_strong_password@127.0.0.1:5432/scale_db?sslmode=disable

# Redis — must be 127.0.0.1 / localhost
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Relay
DERP_AUTH_KEY=replace_with_relay_shared_secret
RELAY_URL=wss://127.0.0.1:8443/derp?auth=replace_with_relay_shared_secret

# Client (optional; prefer `scale login`)
WG_CONTROL_SERVER=https://127.0.0.1:8080
WG_INTERFACE=wg0
WG_PORT=51820
